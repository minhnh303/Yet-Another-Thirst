{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Yet Another Thirst",
  "description": "A thirst mod for Minecraft.",
  "authors": ["minhnh"],
  "license": "MIT",
  "icon": "assets/yet_another_thirst/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.minhnh.yetanotherthirst.YetAnotherThirstFabric"
    ],
    "client": [
      "dev.minhnh.yetanotherthirst.YetAnotherThirstFabricClient"
    ],
    "fabric-gametest": [
      "dev.minhnh.yetanotherthirst.gametest.FabricThirstGameTests"
    ]
  },
  "mixins": [
    "yet_another_thirst.mixins.json",
    "yet_another_thirst.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}"
  }
}
