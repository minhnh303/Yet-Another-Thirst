{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "https://github.com/minhnh303/Yet-Another-Thirst",
    "sources": "https://github.com/minhnh303/Yet-Another-Thirst",
    "issues": "https://github.com/minhnh303/Yet-Another-Thirst/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.minhnh.yetanotherthirst.YetAnotherThirstFabric"
    ],
    "client": [
      "dev.minhnh.yetanotherthirst.YetAnotherThirstFabricClient"
    ],
    "jade": [
      "dev.minhnh.yetanotherthirst.compat.JadeCompatPlugin"
    ],
    "modmenu": [
      "dev.minhnh.yetanotherthirst.FabricModMenuIntegration"
    ],
    "fabric-gametest": [
      "dev.minhnh.yetanotherthirst.gametest.ThirstGameTests"
    ]
  },
  "mixins": [
    "yet_another_thirst.fabric.mixins.json",
    "yet_another_thirst.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}"
  },
  "suggests": {
    "modmenu": "*",
    "jade": "*",
    "appleskin": "*",
    "toughasnails": "*",
    "supernatural": "*",
    "farmersdelight": "*",
    "bakery": "*",
    "brewery": "*",
    "farm_and_charm": "*",
    "create": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/yet-another-thirst",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/yet-another-thirst"
      }
    }
  }
}
